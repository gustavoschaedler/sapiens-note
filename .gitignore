# Build output
/build/
build/
build*/
_deps/
*.o
*.obj
*.a
*.lib

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
Testing/

# Editors / OS
.DS_Store
**/.DS_Store
.vscode/
.idea/
compile_commands.json

# Tooling caches (clangd index, ccache, etc.)
.cache/
**/.cache/

# ESP-IDF component manager (fetched deps + lockfile)
**/managed_components/
**/dependencies.lock

# Generated at build time (host-clock seed written into the firmware for the RTC)
firmware/main/hal/BuildClock.h

# Render dumps / scratch output (the committed UI images live in assets/)
/out/
*.ppm
*.wav

# App data created at runtime (lives in $HOME/.sapiensnote-sim, not in the repo)
*.sapiensnote-data/
.sapiensnote-sim/
